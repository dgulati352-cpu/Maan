# ==============================================================================
# ShaadiSnap AI - Face Recognition Service Environment Variables
# ==============================================================================

# Internal Service-to-Service Security
SHAADISNAP_INTERNAL_API_KEY=shaadisnap_dev_secret_key_2026_change_in_production
ALLOWED_ORIGINS=https://app.shaadisnap.ai,https://admin.shaadisnap.ai

# Model & Architecture Configuration
MODEL_NAME=iresnet50
CHECKPOINT_PATH=checkpoints/checkpoint_best.pt
DEFAULT_MATCH_THRESHOLD=0.42
DEVICE=cpu

# Server Configuration
PORT=8000
HOST=0.0.0.0
WORKERS=2
LOG_LEVEL=info

# Privacy & Audit Logging
ENABLE_AUDIT_LOGGING=true
MASK_PII_IN_LOGS=true
EPHEMERAL_SELFIE_RETENTION_SECONDS=0
